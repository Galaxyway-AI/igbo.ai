---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout title="Funding transparency"
  ><PageHero
    eyebrow="FUNDING TRANSPARENCY"
    title="Support should come with clarity."
    description="Funding objectives and approved progress reports will be published as campaigns are established."
  /><section class="section container">
    <div class="empty-state">
      <h2>No funding totals announced.</h2><p>
        We will not publish estimated or unverified support figures. Future
        campaigns may cover recording sessions, annotation, IgboSpeechBench,
        IgboPhonemizer, compute and dialect expansion.
      </p><a class="text-link" href="/support#sponsorship"
        >Discuss a funding objective →</a
      >
    </div><div id="campaigns" class="resource-grid"></div>
  </section></Layout
>
<script>
  fetch('/api/public/campaigns')
    .then((r) => (r.ok ? r.json() : []))
    .then((rows: { title: string; summary: string }[]) =>
      rows.forEach((row) => {
        const a = document.createElement('article');
        a.className = 'resource-card';
        const h = document.createElement('h3');
        h.textContent = row.title;
        const p = document.createElement('p');
        p.textContent = row.summary;
        a.append(h, p);
        document.querySelector('#campaigns')?.append(a);
      }),
    )
    .catch(() => {});
</script>
