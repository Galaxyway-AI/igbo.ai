---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Research updates"
  ><PageHero
    eyebrow="THE RESEARCH JOURNAL"
    title="Progress, documented."
    description="Research notes, methods, milestones and limitations. Evidence before announcements."
  /><section class="section container">
    <div id="updates-list" class="resource-grid"></div><div
      class="empty-state"
      id="updates-empty"
    >
      <span class="eyebrow">PLANNING & RESEARCH</span><h2>
        The journal records the work as it develops.
      </h2><p>
        Published reviews describe desk research, methods and limitations. They do not imply completed model training, native-speaker studies or released AI services.
      </p><a class="text-link" href="/roadmap">Explore the roadmap →</a>
    </div>
  </section></Layout
>
