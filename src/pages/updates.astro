---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Research updates"
  ><PageHero
    eyebrow="THE RESEARCH JOURNAL"
    title="Progress, documented."
    description="Research notes, methods, milestones and limitations. Evidence before announcements."
  /><section class="section container">
    <div id="updates-list" class="resource-grid"></div><div
      class="empty-state"
      id="updates-empty"
    >
      <span class="eyebrow">PLANNING & RESEARCH</span><h2>
        The journal starts with the work.
      </h2><p>
        There are no published research updates yet. The roadmap outlines our
        intended direction without implying completed experiments or results.
      </p><a class="text-link" href="/roadmap">Explore the roadmap →</a>
    </div>
  </section></Layout
>
