---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
const pages = {
  about: {
    eyebrow: 'ABOUT IGBO AI',
    title: 'An open initiative. A lasting foundation.',
    description:
      'Igbo AI is an open language technology initiative led by Galaxyway AI.',
    sections: [
      [
        'Our mission',
        'We aim to build reusable research, datasets and technology that can help artificial intelligence understand, pronounce and speak Igbo more naturally. We want native speakers, researchers and technologists to shape what good language technology means together.',
      ],
      [
        'Led by Galaxyway AI. Open to collaboration.',
        'Galaxyway AI initiated and leads the project. Igbo AI has its own research identity and welcomes collaboration with universities, linguists, developers, communities, technology companies and funders. Participation is intended to be collaborative, with scope, credit and responsibilities agreed openly.',
      ],
      [
        'Where we are today',
        'The initiative is in planning and research. Work centres on the research landscape, collaborators, linguistic foundations and evaluation design. No proprietary Igbo model has been released through this programme.',
      ],
      [
        'People & governance',
        'Confirmed contributors and governance arrangements will be published as the programme develops, with permission. No institutional relationships or advisory appointments are implied before they are agreed.',
      ],
    ],
  },
  ethics: {
    eyebrow: 'DATA & VOICE ETHICS',
    title: 'A language is a responsibility.',
    description:
      'Responsible research starts with respect for the people behind the data.',
    sections: [
      [
        'Informed consent',
        'Before any voice collection opens, contributors must understand the proposed uses, including research, training, synthesis, recognition, generative AI, redistribution and any commercial use. Retention and withdrawal limits must be explained explicitly.',
      ],
      [
        'Voice rights & provenance',
        'We will not build speech datasets from indiscriminately scraped, unconsented voices. Sources, licences and permissions must be traceable before material is used or released.',
      ],
      [
        'Dialect representation',
        'No single dialect should be treated as the only legitimate Igbo. Dialect communities and linguistic experts should shape representation and evaluation.',
      ],
      [
        'Native-speaker validation',
        'Automated metrics alone cannot define success. Native-speaker judgements of pronunciation, tone, intelligibility and naturalness are central to the research design.',
      ],
      [
        'Licensing & transparency',
        'Resources should be released only where source licences and contributor consent allow. Dataset and model documentation should explain limitations, intended uses and evaluation methods.',
      ],
      [
        'Privacy & withdrawal',
        'Personal contact information should be separated from research responses where practical. Contributor terms must state retention, access controls and the practical limits of withdrawing data after a permitted public release.',
      ],
      [
        'Children’s voices',
        'Children’s speech is a separate high-risk area requiring explicit policies and safeguards. This platform does not currently collect voice recordings from children or adults.',
      ],
    ],
  },
  privacy: {
    eyebrow: 'PRIVACY / PRE-LAUNCH NOTICE',
    title: 'Your information deserves care.',
    description:
      'This notice describes the intended platform data flows. The receiving legal entity, retention schedule and final privacy policy must be approved before public data collection opens.',
    sections: [
      [
        'Information you choose to share',
        'Collaboration and sponsorship forms collect contact details, professional context and your message. Optional fields can be left blank. No voice collection is active.',
      ],
      [
        'Purpose and access',
        'Submitted information is used to review expressions of interest and respond to enquiries. Access is restricted to authorised project administrators. Turnstile may process technical information to prevent automated abuse.',
      ],
      [
        'Supporter privacy',
        'Supporter acknowledgement is optional, private by default and subject to approval. Payment processing will take place through a configured payment provider; this application does not store raw card details.',
      ],
      [
        'Storage and service providers',
        'The intended infrastructure uses Cloudflare Workers and D1. Configured email and payment providers may process information necessary to deliver their services. Final provider names, transfer details and retention periods must be published before collection is enabled.',
      ],
      [
        'Your choices',
        'You may decline optional fields and remain publicly anonymous. Privacy requests may be directed to support@igbo.ai. The final policy will specify the responsible entity and applicable rights.',
      ],
      [
        'Cookies and analytics',
        'No advertising or invasive profiling is included. Cloudflare Access may use an authentication cookie for administrators, and Turnstile may use security mechanisms. Optional analytics are disabled until configured and reviewed.',
      ],
    ],
  },
  terms: {
    eyebrow: 'TERMS / PRE-LAUNCH NOTICE',
    title: 'Clear expectations, from the start.',
    description:
      'These preliminary usage principles require owner approval and receiving entity details before production launch.',
    sections: [
      [
        'Research status',
        'Igbo AI is in planning and research. Planned technologies and interface previews are not released models or guarantees of future results.',
      ],
      [
        'Contributions and collaboration',
        'Submitting an expression of interest does not establish employment, a partnership, ownership rights or a contract. Research contributions, attribution and licences require separate agreement.',
      ],
      [
        'Support',
        'Support is for an initiative led by Galaxyway AI. It is not represented as a charitable donation. Payment provider terms, receiving entity information and applicable refund terms must be supplied before payment collection is enabled.',
      ],
      [
        'Responsible use',
        'Do not submit information you lack permission to share, abusive content or sensitive recordings. Voice collection and AI inference are not active in this release by default.',
      ],
      [
        'External resources',
        'External research resources remain subject to their respective owners’ terms and licences. Mentioning them does not imply endorsement or partnership.',
      ],
    ],
  },
  'open-source': {
    eyebrow: 'OPEN SOURCE',
    title: 'Useful foundations should be reusable.',
    description:
      'Our goal is to release datasets, tools, benchmarks and model components wherever licensing and contributor consent allow.',
    sections: [
      [
        'Planned resources',
        'IgboPronounce, IgboPhonemizer, IgboSpeechBench, IgboSpeech TTS and IgboSpeech ASR are planned components. No public repositories, versions or licences are announced yet.',
      ],
      [
        'Release principles',
        'Future resource records will include source repositories, documentation, versions, licences, release dates, intended uses and known limitations. Each source must be reviewed before redistribution.',
      ],
      [
        'Build with us',
        'Developers can help shape reproducible experiments, annotation tooling, Unicode-preserving language infrastructure and accessible interfaces. Join the collaboration programme to discuss where your expertise fits.',
      ],
    ],
  },
  participate: {
    eyebrow: 'COMMUNITY PARTICIPATION',
    title: 'The people who speak it should shape it.',
    description:
      'Future opportunities to contribute language expertise, evaluate pronunciation and participate in responsible speech research.',
    sections: [
      [
        'Share your knowledge',
        'Native speakers and dialect experts can express interest through the collaboration form today, once data collection is configured.',
      ],
      [
        'Voice contributions — coming soon',
        'Recording will remain disabled until contributor terms, consent, retention, withdrawal and review processes are approved. No microphone access is requested by this preview.',
      ],
      [
        'Pronunciation evaluation — planned',
        'Future studies may compare anonymised audio samples and ask about pronunciation, tone, rhythm, dialect and intelligibility. Study identifiers and consent will make research responses traceable without publishing personal contact information.',
      ],
    ],
  },
};
export function getStaticPaths() {
  return [
    'about',
    'ethics',
    'privacy',
    'terms',
    'open-source',
    'participate',
  ].map((page) => ({ params: { page } }));
}
const page = pages[Astro.params.page as keyof typeof pages];
---

<Layout title={page.title}
  ><PageHero
    eyebrow={page.eyebrow}
    title={page.title}
    description={page.description}
  /><section class="section container">
    <div class="prose">
      {
        page.sections.map(([title, body]) => (
          <section>
            <>
              <h2>{title}</h2>
              <p>{body}</p>
            </>
          </section>
        ))
      }<div style="margin-top:40px">
        <a class="button" href="/collaborate">Collaborate with us ↗</a>
      </div>{
        Astro.params.page === 'about' && (
          <p>
            <a href="https://www.galaxyway.ai">Visit Galaxyway AI ↗</a> ·{' '}
            <a href="https://www.galaxyway.ai/research/igbo-ai">
              Original programme record ↗
            </a>
          </p>
        )
      }
    </div>
  </section></Layout
>
