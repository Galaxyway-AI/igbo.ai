---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { technologies } from '../../data/project';
import { technologyDetails } from '../../data/technologyDetails';
export function getStaticPaths() {
  return technologies.map((tech) => ({
    params: { slug: tech.slug },
    props: {
      tech,
      details: technologyDetails[tech.slug as keyof typeof technologyDetails],
    },
  }));
}
const { tech, details } = Astro.props;
const flows =
  tech.slug === 'igbospeech'
    ? [details.pipeline.slice(0, 4), details.pipeline.slice(4)]
    : [details.pipeline];
---

<Layout title={tech.name} description={tech.description}>
  <PageHero
    eyebrow={`TECHNOLOGY / ${tech.category}`}
    title={tech.name}
    description={tech.description}
  />
  <section class="section container technology-intro">
    <aside class="panel">
      <span class="tech-icon" aria-hidden="true">{tech.icon}</span>
      <h2>Current status</h2>
      <p><strong data-tech-status>{tech.status}</strong></p>
      <p>
        Target: To be confirmed<br />Licence: Determined per future output and
        its source materials.
      </p>
      <p class="fine-print">
        This is a proposed research component. No production model or dataset is
        implied.
      </p>
    </aside>
    <div class="prose">
      <span class="eyebrow">WHAT IS IT?</span><h2>{details.what}</h2>
      <span class="eyebrow">WHY DO WE NEED IT?</span><p>{details.why}</p>
    </div>
  </section>
  <section class="section container">
    <div class="panel">
      {tech.slug === 'igbopronounce' && <><span class="eyebrow">FIRST-VERSION RECORD</span><p>Each record is intended to preserve a stable ID, source and normalised form, sense/context, variety label, phoneme and tone representations, authorised audio reference, provenance, permissions, reviewer decisions, confidence and revision history. A spelling may have multiple legitimate senses and pronunciations; alternatives will not be silently collapsed.</p></>}
      {tech.slug === 'igbotone' && <><span class="eyebrow">UNCERTAINTY BY DESIGN</span><p>Original user text remains intact. Alternative readings, uncertainty and human override are first-class fields. Reviewed annotations are evaluated separately from automatic predictions, and restoration is useful only when it avoids meaning-changing errors.</p></>}
      {tech.slug === 'igbophonemizer' && <><span class="eyebrow">HYBRID COMPARISON</span><p>We will compare reviewed lexicon lookup, linguistic rules and learned grapheme-to-phoneme mappings. IPA can support human review while a model consumes another documented token system. Names, code-switching and variety-specific rules belong in the error taxonomy.</p></>}
      {tech.slug === 'igbospeechbench' && <><span class="eyebrow">PROPOSED PROTOCOL</span><p>Use speaker/session-disjoint splits, held-out and fresh audit material, blind presentation, randomised order, listener-group reporting, confidence intervals and disagreement reporting. Dialect familiarity or preference must be distinguished from linguistic correctness. No study or audio collection is active.</p></>}
      {tech.slug === 'igbospeech' && <><span class="eyebrow">TWO DISTINCT TRACKS</span><p>TTS begins with one authorised voice; ASR begins by testing current systems before adapting to measured gaps. General research consent does not imply voice-synthesis permission. Restricted comparators may be evaluated in an isolated research track while the intended public release uses approved assets. Code licences do not override restrictions on weights or data.</p></>}
      {tech.slug === 'igbolm' && <><span class="eyebrow">LATER-STAGE SCOPE</span><p>Begin with retrieval and tools, prompting and small supervised adaptations before considering larger training. Speech quality is not solved by pretraining a general text model; this component remains later-stage and task-specific.</p></>}
    </div>
  </section>
  <section class="section soft-section">
    <div class="container">
      <span class="eyebrow">CONCEPTUAL FLOW</span>
      {
        flows.map((flow, flowIndex) => (
          <div>
            {tech.slug === 'igbospeech' && (
              <h2>
                {flowIndex === 0
                  ? 'Text-to-speech (TTS)'
                  : 'Automatic speech recognition (ASR)'}
              </h2>
            )}
            <div
              class:list={['technology-flow', { 'long-flow': flow.length > 4 }]}
            >
              {flow.map((step: string, i: number) => (
                <>
                  <span>{step}</span>
                  {i < flow.length - 1 && <b aria-hidden="true">↓</b>}
                </>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
  <section class="section container">
    <div class="technology-columns">
      <article>
        <span class="eyebrow">WHAT GOES IN?</span>
        <ul>{details.inputs.map((item: string) => <li>{item}</li>)}</ul>
      </article>
      <article>
        <span class="eyebrow">PROCESSING / PROPOSED ARCHITECTURE</span><p>
          {details.processing}
        </p>
      </article>
      <article>
        <span class="eyebrow">WHAT COMES OUT?</span>
        <ul>{details.outputs.map((item: string) => <li>{item}</li>)}</ul>
      </article>
    </div>
  </section>
  <section class="section container">
    <h2>{details.focusTitle}</h2>
    <ul class="technology-focus">
      {details.focus.map((item: string) => <li>{item}</li>)}
    </ul>
  </section>
  <section class="section soft-section">
    <div class="container two-col">
      <div>
        <span class="eyebrow">WHAT DOES SUCCESS LOOK LIKE?</span>
        <h2>{details.successTitle}</h2><p>{details.success}</p>
      </div>
      <div>
        <span class="eyebrow">DEPENDENCIES</span>
        <ul>{details.dependencies.map((item: string) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>
  <section class="section container two-col">
    <div>
      <span class="eyebrow">PLANNED OPEN-SOURCE OUTPUTS</span>
      <ul>{details.open.map((item: string) => <li>{item}</li>)}</ul>
      <p class="fine-print">
        Release depends on provenance, consent, third-party licences and
        technical readiness.
      </p>
    </div>
    <div>
      <span class="eyebrow">RESEARCH QUESTIONS</span>
      <ol>{details.questions.map((item: string) => <li>{item}</li>)}</ol>
    </div>
  </section>
  {
    tech.slug === 'igbospeechbench' && (
      <section class="section container">
        <div class="benchmark-preview">
          <span class="eyebrow">BLIND A/B EVALUATION CONCEPT</span>
          <p>Sentence</p>
          <div>
            <>
              <button disabled>Voice A ▶</button>
              <button disabled>Voice B ▶</button>
            </>
          </div>
          <p>Which sounds more natural?</p>
          <div>
            <>
              <button disabled>A</button>
              <button disabled>B</button>
              <button disabled>About the same</button>
              <button disabled>Neither</button>
            </>
          </div>
          <small>
            Interface concept · no audio or evaluation collection is active
          </small>
        </div>
      </section>
    )
  }
  <section class="section container">
    <a class="button" href="/collaborate">Help shape this work →</a>
  </section>
</Layout>
