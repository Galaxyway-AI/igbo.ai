---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
const groups = [
  [
    'Programme',
    [
      ['dashboard', 'Overview'],
      ['roadmap', 'Roadmap'],
      ['updates', 'Research updates'],
      ['resources', 'Research resources'],
      ['projects', 'Technology statuses'],
    ],
  ],
  [
    'People & partners',
    [
      ['collaborators', 'Collaborators'],
      ['organisations', 'Organisations'],
      ['sponsorship', 'Sponsorship enquiries'],
    ],
  ],
  [
    'Support',
    [
      ['supporters', 'Supporters'],
      ['campaigns', 'Funding campaigns'],
    ],
  ],
  ['Lab & research', [['feedback', 'Lab feedback']]],
  [
    'System',
    [
      ['email', 'Email delivery'],
      ['audit', 'Audit log'],
      ['settings', 'Site settings'],
    ],
  ],
] as const;
---

<Layout title="Administration" noindex
  ><PageHero
    eyebrow="PRIVATE ADMINISTRATION"
    title="The research desk."
    description="Manage the programme, review expressions of interest and publish verified progress."
  /><section class="section container">
    <div id="admin-lock" class="notice" role="status">
      Checking administrator access…
    </div><div id="admin-workspace" hidden>
      <div class="admin-topbar">
        <span class="status" id="admin-environment"></span><span
          id="admin-identity"></span><a href="/" target="_blank" rel="noopener"
          >View public site →</a
        ><a href="/cdn-cgi/access/logout">Sign out</a>
      </div><div class="admin-layout">
        <details class="admin-sidebar" open>
          <summary>Research Desk navigation</summary><nav
            class="admin-nav"
            aria-label="Administration sections"
          >
            {
              groups.map(([group, items]) => (
                <section>
                  <h3>{group}</h3>
                  {items.map(([key, label]) => (
                    <button
                      data-admin-section={key}
                      aria-pressed={key === 'dashboard' ? 'true' : 'false'}
                    >
                      {label}
                      <span data-count={key} />
                    </button>
                  ))}
                </section>
              ))
            }
          </nav>
        </details><div class="admin-content">
          <h2 id="admin-title" style="font-size:28px;margin-bottom:20px">
            Overview
          </h2><div style="display:flex;gap:12px;margin-bottom:20px">
            <input
              type="search"
              class="admin-search"
              id="admin-search"
              placeholder="Search this section…"
              aria-label="Search records"
            /><details class="create-menu" id="admin-create">
              <summary class="button">+ Create</summary><div>
                {
                  [
                    ['updates', 'Research update'],
                    ['resources', 'Research resource'],
                    ['roadmap', 'Roadmap phase'],
                    ['organisations', 'Organisation'],
                    ['campaigns', 'Funding campaign'],
                  ].map(([key, label]) => (
                    <button type="button" data-create={key}>
                      New {label}
                    </button>
                  ))
                }
              </div>
            </details>
          </div><p id="admin-status" role="status" class="form-status"></p><div
            id="admin-records"
          >
          </div>
        </div>
      </div>
    </div>
  </section></Layout
>
<script>
  import '../scripts/admin';
</script>
